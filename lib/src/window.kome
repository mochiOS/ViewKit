extern "C" from "viewkit" {
	// Opens a native window with a borrowed UTF-8 title.
	fn vk_runtime_run_window_utf8(runtime: *mut VkRuntime, title: *const u8, title_length: usize, width: f32, height: f32, resizable: u8) -> i32
	// Builds a view tree from a Kome closure and runs it in a native window.
	fn vk_kome_run_window_action_utf8(title: *const u8, title_length: usize, width: f32, height: f32, resizable: u8, content: () -> Null) -> i32
}

/// 指定された内容を表示するウィンドウを実行します。
///
/// ViewKitが描画環境とノード識別子を管理するため、内容では`VStack`、`Text`、`Button`などを直接使用できます。
///
/// ## Parameters
///
/// - `title`: ウィンドウのタイトルです。
/// - `content`: ウィンドウに表示する内容を構築する処理です。
/// - `width`: ウィンドウの幅です。
/// - `height`: ウィンドウの高さです。
/// - `resizable`: 大きさを変更できる場合は`1`、できない場合は`0`です。
///
/// ## Returns
///
/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
///
/// ## Example
///
/// ```kome
/// Window("Kome", width: 800, height: 600) {
/// 	Text("こんにちは")
/// }
/// ```
///
/// @since 27.0-dp.1
pub fn Window(title: String, content: () -> Null, width: f32 = 800, height: f32 = 600, resizable: u8 = 1) -> i32 {
	return vk_kome_run_window_action_utf8(__kome_string_data(title), __kome_string_len(title), width, height, resizable, content)
}

/// 指定されたタイトル、大きさ、サイズ変更可否でViewKitのウィンドウを実行します。
///
/// ## Parameters
///
/// - `runtime`: 対象のViewKit実行環境です。
/// - `title`: ウィンドウのタイトルです。
/// - `width`: ウィンドウの幅です。
/// - `height`: ウィンドウの高さです。
/// - `resizable`: 大きさを変更できる場合は`1`、できない場合は`0`です。
///
/// ## Returns
///
/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
///
/// ## Example
///
/// ```kome
/// let status = runViewWindow(runtime, "Kome", 800, 600, 1)
/// ```
///
/// @since 27.0-dp.1
pub fn runViewWindow(runtime: *mut VkRuntime, title: String, width: f32, height: f32, resizable: u8) -> i32 {
	return vk_runtime_run_window_utf8(runtime, __kome_string_data(title), __kome_string_len(title), width, height, resizable)
}
