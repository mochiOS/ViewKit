extern "C" {
	/// ViewKitの描画状態と実行状態を保持する実行環境です。
	///
	/// @since 27.0-dp.1
	pub struct VkRuntime

	// Returns a borrowed pointer to a Kome String's UTF-8 bytes.
	fn __kome_string_data(value: String) -> *const u8

	// Returns the byte length of a Kome String.
	fn __kome_string_len(value: String) -> usize
}

extern "C" from "viewkit" {
	// Returns the ViewKit C ABI version.
	fn vk_abi_version() -> u32

	// Creates a ViewKit runtime for a component instance.
	fn vk_runtime_create(component_instance_id: u64) -> *mut VkRuntime

	// Destroys a ViewKit runtime.
	fn vk_runtime_destroy(runtime: *mut VkRuntime) -> i32

	// Starts building a view tree.
	fn vk_tree_begin(runtime: *mut VkRuntime, root_node_id: u64) -> i32

	// Aborts the active view-tree build.
	fn vk_tree_abort(runtime: *mut VkRuntime) -> i32

	// Closes the current container node.
	fn vk_end_node(runtime: *mut VkRuntime) -> i32

	// Commits the active view tree.
	fn vk_tree_commit(runtime: *mut VkRuntime) -> i32

	// Collects pending UI actions.
	fn vk_runtime_collect_actions(runtime: *mut VkRuntime) -> i32

	// Stores a boolean state value.
	fn vk_state_set_bool(runtime: *mut VkRuntime, state_id: u64, value: u8) -> i32

	// Stores a floating-point state value.
	fn vk_state_set_f32(runtime: *mut VkRuntime, state_id: u64, value: f32) -> i32

	// Stores an unsigned integer state value.
	fn vk_state_set_u64(runtime: *mut VkRuntime, state_id: u64, value: u64) -> i32

	// Stores a string state value from borrowed UTF-8 bytes.
	fn vk_state_set_string_utf8(runtime: *mut VkRuntime, state_id: u64, pointer: *const u8, length: usize) -> i32

	// Opens a native window with a borrowed UTF-8 title.
	fn vk_runtime_run_window_utf8(runtime: *mut VkRuntime, title: *const u8, title_length: usize, width: f32, height: f32, resizable: u8) -> i32

	// Begins a vertical stack container.
	fn vk_begin_vstack(runtime: *mut VkRuntime, node_id: u64, gap: u32, alignment: u32, distribution: u32) -> i32

	// Begins a horizontal stack container.
	fn vk_begin_hstack(runtime: *mut VkRuntime, node_id: u64, gap: u32, alignment: u32, distribution: u32) -> i32

	// Begins a depth stack container.
	fn vk_begin_zstack(runtime: *mut VkRuntime, node_id: u64, alignment: u32) -> i32

	// Pushes a text node from borrowed UTF-8 bytes.
	fn vk_push_text_utf8(runtime: *mut VkRuntime, node_id: u64, content: *const u8, content_length: usize, font_size: f32, line_height: f32, weight: u16, alignment: u32, color: u32) -> i32

	// Pushes semantic text from borrowed UTF-8 bytes.
	fn vk_push_text_role_utf8(runtime: *mut VkRuntime, node_id: u64, content: *const u8, content_length: usize, role: u32, tone: u32, alignment: u32) -> i32

	// Pushes a button from a borrowed UTF-8 title.
	fn vk_push_button_utf8(runtime: *mut VkRuntime, node_id: u64, title: *const u8, title_length: usize, color: u32, radius: f32, action_id: u64) -> i32

	// Pushes a semantic button from a borrowed UTF-8 title.
	fn vk_push_button_semantic_utf8(runtime: *mut VkRuntime, node_id: u64, title: *const u8, title_length: usize, style: u32, size: u32, action_id: u64) -> i32

	// Begins a padding container.
	fn vk_begin_padding(runtime: *mut VkRuntime, node_id: u64, top: f32, right: f32, bottom: f32, left: f32) -> i32

	// Pushes a flexible spacer.
	fn vk_push_spacer(runtime: *mut VkRuntime, node_id: u64) -> i32

	// Pushes a divider.
	fn vk_push_divider(runtime: *mut VkRuntime, node_id: u64) -> i32

	// Begins a context-menu container.
	fn vk_begin_context_menu(runtime: *mut VkRuntime, node_id: u64) -> i32

	// Begins a transparent group container.
	fn vk_begin_group(runtime: *mut VkRuntime, node_id: u64) -> i32

	// Begins an overlay container.
	fn vk_begin_overlay(runtime: *mut VkRuntime, node_id: u64, alignment: u32) -> i32

	// Begins a scroll container.
	fn vk_begin_scroll(runtime: *mut VkRuntime, node_id: u64, state_id: u64, axis: u32, scrollbar: u32) -> i32

	// Pushes a text field from borrowed UTF-8 strings.
	fn vk_push_text_field_utf8(runtime: *mut VkRuntime, node_id: u64, state_id: u64, value: *const u8, value_length: usize, placeholder: *const u8, placeholder_length: usize, size: u32, radius: f32, enabled: u8, invalid: u8) -> i32

	// Pushes a menu item from borrowed UTF-8 strings.
	fn vk_push_menu_item_utf8(runtime: *mut VkRuntime, node_id: u64, label: *const u8, label_length: usize, shortcut: *const u8, shortcut_length: usize, enabled: u8, danger: u8, action_id: u64) -> i32
}

/// 垂直方向へ子ノードを並べるコンテナを開始します。
///
/// ## Parameters
///
/// - `runtime`: 対象のViewKit実行環境です。
/// - `node_id`: ノードの識別子です。
/// - `gap`: 子ノード間の間隔です。
/// - `alignment`: 交差方向の配置です。
/// - `distribution`: 主方向の配置です。
///
/// ## Returns
///
/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
///
/// ## Example
///
/// ```kome
/// let status = beginViewVStack(runtime, 1, 8, 0, 0)
/// ```
///
/// @since 27.0-dp.1
pub fn beginViewVStack(runtime: *mut VkRuntime, node_id: u64, gap: u32, alignment: u32, distribution: u32) -> i32 {
	return vk_begin_vstack(runtime, node_id, gap, alignment, distribution)
}

/// 水平方向へ子ノードを並べるコンテナを開始します。
///
/// ## Parameters
///
/// - `runtime`: 対象のViewKit実行環境です。
/// - `node_id`: ノードの識別子です。
/// - `gap`: 子ノード間の間隔です。
/// - `alignment`: 交差方向の配置です。
/// - `distribution`: 主方向の配置です。
///
/// ## Returns
///
/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
///
/// ## Example
///
/// ```kome
/// let status = beginViewHStack(runtime, 1, 8, 0, 0)
/// ```
///
/// @since 27.0-dp.1
pub fn beginViewHStack(runtime: *mut VkRuntime, node_id: u64, gap: u32, alignment: u32, distribution: u32) -> i32 {
	return vk_begin_hstack(runtime, node_id, gap, alignment, distribution)
}

/// 現在のコンテナノードを終了します。
///
/// ## Parameters
///
/// - `runtime`: 対象のViewKit実行環境です。
///
/// ## Returns
///
/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
///
/// ## Example
///
/// ```kome
/// let status = endViewNode(runtime)
/// ```
///
/// @since 27.0-dp.1
pub fn endViewNode(runtime: *mut VkRuntime) -> i32 {
	return vk_end_node(runtime)
}

/// 文字列をViewKitの状態へ保存します。
///
/// `runtime`の`state_id`へ`value`を保存し、操作結果を表すステータスコードを返します。
///
/// ## Parameters
///
/// - `runtime`: 対象のViewKit実行環境です。
/// - `state_id`: 更新する状態の識別子です。
/// - `value`: 保存する文字列です。
///
/// ## Returns
///
/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
///
/// ## Example
///
/// ```kome
/// let status = setViewString(runtime, 1, "Kome")
/// ```
///
/// @since 27.0-dp.1
pub fn setViewString(runtime: *mut VkRuntime, state_id: u64, value: String) -> i32 {
	return vk_state_set_string_utf8(runtime, state_id, __kome_string_data(value), __kome_string_len(value))
}

/// 指定されたタイトル、大きさ、サイズ変更可否でViewKitのウィンドウを実行します。
///
/// ## Parameters
///
/// - `runtime`: 対象のViewKit実行環境です。
/// - `title`: ウィンドウのタイトルです。
/// - `width`: ウィンドウの幅です。
/// - `height`: ウィンドウの高さです。
/// - `resizable`: 大きさを変更できる場合は`1`、できない場合は`0`です。
///
/// ## Returns
///
/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
///
/// ## Example
///
/// ```kome
/// let status = runViewWindow(runtime, "Kome", 800, 600, 1)
/// ```
///
/// @since 27.0-dp.1
pub fn runViewWindow(runtime: *mut VkRuntime, title: String, width: f32, height: f32, resizable: u8) -> i32 {
	return vk_runtime_run_window_utf8(runtime, __kome_string_data(title), __kome_string_len(title), width, height, resizable)
}

/// 内容、書式、配置、色を指定してテキストノードを追加します。
///
/// ## Parameters
///
/// - `runtime`: 対象のViewKit実行環境です。
/// - `node_id`: ノードの識別子です。
/// - `content`: 表示する文字列です。
/// - `font_size`: 文字の大きさです。
/// - `line_height`: 行の高さです。
/// - `weight`: 文字の太さです。
/// - `alignment`: 文字の配置です。
/// - `color`: 文字色です。
///
/// ## Returns
///
/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
///
/// ## Example
///
/// ```kome
/// let status = pushViewText(runtime, 1, "Kome", 16, 20, 400, 0, 0)
/// ```
///
/// @since 27.0-dp.1
pub fn pushViewText(runtime: *mut VkRuntime, node_id: u64, content: String, font_size: f32, line_height: f32, weight: u16, alignment: u32, color: u32) -> i32 {
	return vk_push_text_utf8(runtime, node_id, __kome_string_data(content), __kome_string_len(content), font_size, line_height, weight, alignment, color)
}

/// 意味上の役割、色調、配置を指定してテキストノードを追加します。
///
/// ## Parameters
///
/// - `runtime`: 対象のViewKit実行環境です。
/// - `node_id`: ノードの識別子です。
/// - `content`: 表示する文字列です。
/// - `role`: テキストの役割です。
/// - `tone`: テキストの色調です。
/// - `alignment`: 文字の配置です。
///
/// ## Returns
///
/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
///
/// ## Example
///
/// ```kome
/// let status = pushViewTextRole(runtime, 1, "Kome", 0, 0, 0)
/// ```
///
/// @since 27.0-dp.1
pub fn pushViewTextRole(runtime: *mut VkRuntime, node_id: u64, content: String, role: u32, tone: u32, alignment: u32) -> i32 {
	return vk_push_text_role_utf8(runtime, node_id, __kome_string_data(content), __kome_string_len(content), role, tone, alignment)
}

/// タイトル、色、角の半径、操作識別子を指定してボタンノードを追加します。
///
/// ## Parameters
///
/// - `runtime`: 対象のViewKit実行環境です。
/// - `node_id`: ノードの識別子です。
/// - `title`: ボタンのタイトルです。
/// - `color`: ボタンの色です。
/// - `radius`: 角の半径です。
/// - `action_id`: 押下時に通知する操作の識別子です。
///
/// ## Returns
///
/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
///
/// ## Example
///
/// ```kome
/// let status = pushViewButton(runtime, 1, "保存", 0, 8, 1)
/// ```
///
/// @since 27.0-dp.1
pub fn pushViewButton(runtime: *mut VkRuntime, node_id: u64, title: String, color: u32, radius: f32, action_id: u64) -> i32 {
	return vk_push_button_utf8(runtime, node_id, __kome_string_data(title), __kome_string_len(title), color, radius, action_id)
}

/// 種類、大きさ、操作識別子を指定してボタンノードを追加します。
///
/// ## Parameters
///
/// - `runtime`: 対象のViewKit実行環境です。
/// - `node_id`: ノードの識別子です。
/// - `title`: ボタンのタイトルです。
/// - `style`: ボタンの種類です。
/// - `size`: ボタンの大きさです。
/// - `action_id`: 押下時に通知する操作の識別子です。
///
/// ## Returns
///
/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
///
/// ## Example
///
/// ```kome
/// let status = pushViewButtonSemantic(runtime, 1, "保存", 0, 0, 1)
/// ```
///
/// @since 27.0-dp.1
pub fn pushViewButtonSemantic(runtime: *mut VkRuntime, node_id: u64, title: String, style: u32, size: u32, action_id: u64) -> i32 {
	return vk_push_button_semantic_utf8(runtime, node_id, __kome_string_data(title), __kome_string_len(title), style, size, action_id)
}

/// 入力値と案内文を持つテキスト入力ノードを追加します。
///
/// ## Parameters
///
/// - `runtime`: 対象のViewKit実行環境です。
/// - `node_id`: ノードの識別子です。
/// - `state_id`: 入力値を保持する状態の識別子です。
/// - `value`: 現在の入力値です。
/// - `placeholder`: 未入力時に表示する案内文です。
/// - `size`: 入力欄の大きさです。
/// - `radius`: 角の半径です。
/// - `enabled`: 入力できる場合は`1`、できない場合は`0`です。
/// - `invalid`: 入力が不正な場合は`1`、正常な場合は`0`です。
///
/// ## Returns
///
/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
///
/// ## Example
///
/// ```kome
/// let status = pushViewTextField(runtime, 1, 1, "", "名前", 0, 8, 1, 0)
/// ```
///
/// @since 27.0-dp.1
pub fn pushViewTextField(runtime: *mut VkRuntime, node_id: u64, state_id: u64, value: String, placeholder: String, size: u32, radius: f32, enabled: u8, invalid: u8) -> i32 {
	return vk_push_text_field_utf8(runtime, node_id, state_id, __kome_string_data(value), __kome_string_len(value), __kome_string_data(placeholder), __kome_string_len(placeholder), size, radius, enabled, invalid)
}

/// ラベル、ショートカット、状態、操作識別子を指定してメニュー項目を追加します。
///
/// ## Parameters
///
/// - `runtime`: 対象のViewKit実行環境です。
/// - `node_id`: ノードの識別子です。
/// - `label`: 項目に表示する文字列です。
/// - `shortcut`: キーボードショートカットです。
/// - `enabled`: 選択できる場合は`1`、できない場合は`0`です。
/// - `danger`: 破壊的な操作の場合は`1`、それ以外は`0`です。
/// - `action_id`: 選択時に通知する操作の識別子です。
///
/// ## Returns
///
/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
///
/// ## Example
///
/// ```kome
/// let status = pushViewMenuItem(runtime, 1, "削除", "", 1, 1, 1)
/// ```
///
/// @since 27.0-dp.1
pub fn pushViewMenuItem(runtime: *mut VkRuntime, node_id: u64, label: String, shortcut: String, enabled: u8, danger: u8, action_id: u64) -> i32 {
	return vk_push_menu_item_utf8(runtime, node_id, __kome_string_data(label), __kome_string_len(label), __kome_string_data(shortcut), __kome_string_len(shortcut), enabled, danger, action_id)
}
