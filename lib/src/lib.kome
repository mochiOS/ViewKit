extern "C" {
	/// ViewKitの描画状態と実行状態を保持する実行環境です。
	///
	/// @since 27.0-dp.1
	pub struct VkRuntime

	// Returns a borrowed pointer to a Kome String's UTF-8 bytes.
	fn __kome_string_data(value: String) -> *const u8

	// Returns the byte length of a Kome String.
	fn __kome_string_len(value: String) -> usize
}

extern "C" from "viewkit" {
	// Returns the ViewKit C ABI version.
	fn vk_abi_version() -> u32
}
