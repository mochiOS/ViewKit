extern "C" from "viewkit" {
	// Begins a vertical stack container.
	fn vk_begin_vstack(runtime: *mut VkRuntime, node_id: u64, gap: StackGap, alignment: StackAlignment, distribution: StackDistribution) -> i32
	// Begins a vertical stack in the active Kome view build.
	fn vk_kome_begin_vstack(gap: StackGap, alignment: StackAlignment, distribution: StackDistribution) -> i32
}

/// 子の表示内容を垂直方向へ並べます。
///
/// ## Parameters
///
/// - `gap`: 子の間隔です。
/// - `alignment`: 交差方向の配置です。
/// - `distribution`: 主方向の配置です。
///
/// ## Example
///
/// ```kome
/// VStack {
/// 	Text("上")
/// 	Text("下")
/// }
/// ```
///
/// @since 27.0-dp.1
pub component VStack(gap: StackGap = .medium, alignment: StackAlignment = .center, distribution: StackDistribution = .start) {
	@beforeChildren
	recipe beginChildren {
		vk_kome_begin_vstack(gap, alignment, distribution)
	}

	@afterChildren
	recipe endChildren {
		vk_kome_end_node()
	}
}

/// 垂直方向へ子ノードを並べるコンテナを開始します。
///
/// ## Parameters
///
/// - `runtime`: 対象のViewKit実行環境です。
/// - `node_id`: ノードの識別子です。
/// - `gap`: 子ノード間の間隔です。
/// - `alignment`: 交差方向の配置です。
/// - `distribution`: 主方向の配置です。
///
/// ## Returns
///
/// 操作結果を表すステータスコードを返します。`0`は成功を表します。
///
/// ## Example
///
/// ```kome
/// let status = beginViewVStack(runtime, 1, 8, 0, 0)
/// ```
///
/// @since 27.0-dp.1
pub fn beginViewVStack(runtime: *mut VkRuntime, node_id: u64, gap: StackGap, alignment: StackAlignment, distribution: StackDistribution) -> i32 {
	return vk_begin_vstack(runtime, node_id, gap, alignment, distribution)
}
